{
  "name": "wp-messenger-og",
  "version": "8.0.0",
  "private": true,
  "description": "WpMessenger OG — Next.js WhatsApp Web Management Panel (App Router) + persistent WhatsApp worker. Deploys on Vercel/Netlify (frontend+API) with the worker on Railway/VPS/Docker.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test",
    "check": "node --check next.config.mjs && node scripts/migrate.js --check",
    "worker:install": "npm --prefix worker install",
    "worker:start": "node worker/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "^15.4.0",
    "pg": "^8.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
