# ─── WpMessenger OG Worker — Environment Variables ───

# HTTP + WebSocket
PORT=3100

# Shared secret — web və worker-də EYNİ olmalıdır
WORKER_API_TOKEN=

# Firebase Realtime Database (realtime event feed + app data)
# WhatsApp auth state is stored on DISK (worker/sessions/), not Firebase.
FIREBASE_ENABLED=true
FIREBASE_DATABASE_URL=https://whatsbotog-default-rtdb.firebaseio.com

# WhatsApp
WA_PRESENCE_CHECK=true
WA_SKIP_UNregistered=true
DUPLICATE_SEND_TTL_MIN=10
UPLOAD_TTL_MS=1800000
