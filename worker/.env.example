# ─── WpMessenger OG Worker — Environment Variables ───
# Bütün məlumatlar Firebase Realtime Database-də saxlanılır (wpm/*) —
# lokal fayl bazası, ./data və PostgreSQL tələb olunmur.
# Firebase konfiqurasiyası defolt olaraq chatog-94528 layihəsidir;
# web app ilə EYNİ dəyərlərdən istifadə edin.

# HTTP + WebSocket
PORT=3100

# Shared secret — web və worker-də EYNİ olmalıdır
WORKER_API_TOKEN=

# Firebase Realtime Database (defolt chatog-94528)
FIREBASE_ENABLED=true
FIREBASE_DATABASE_URL=https://chatog-94528-default-rtdb.firebaseio.com

# WhatsApp
WA_PRESENCE_CHECK=true
WA_SKIP_UNREGISTERED=true
DUPLICATE_SEND_TTL_MIN=10
UPLOAD_TTL_MS=1800000
