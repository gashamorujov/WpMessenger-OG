# ─── WpMessenger OG — Worker Environment Variables ───
# Worker persistent WhatsApp backend üçün. Railway/VPS/Docker-də işləyir.

# HTTP port (Railway/Heroku PORT-u avtomatik istifadə olunur)
PORT=3100

# GİZLİ açar — WEB app-dəki WORKER_API_TOKEN ilə EYNİ olmalıdır
WORKER_API_TOKEN=

# Shared database (web ilə EYNİ DB — jobs orada yaradılır və burada işlənir)
# Local/Compose: /data/app.db · Production: PostgreSQL URL
DATABASE_URL=./data/app.db
DATA_DIR=./data
SESSION_PATH=./sessions

# Broadcast pacing & limits (web Settings səhifəsindən də dəyişdirilə bilər)
BROADCAST_DELAY_MIN_MS=3000
BROADCAST_DELAY_MAX_MS=7000
BROADCAST_MAX_RETRIES=2
DUPLICATE_SEND_TTL_MIN=10
WA_PRESENCE_CHECK=true
WA_SKIP_UNREGISTERED=true
MAX_RECIPIENTS=10000
MAX_MESSAGE_LENGTH=100000
MAX_UPLOAD_BYTES=67108864
WS_TICKET_TTL_SEC=120
