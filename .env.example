# ─── WpMessenger OG — Environment Variables ───
# Copy to .env for local development. Heç bir secret repo-ya yazılmır.
# Boş qalan URL dəyərləri platforma env-lərindən avtomatik təyin olunur
# (RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL / VERCEL_URL / FLY_APP_NAME).

# ─── Web app (Next.js) ───
PORT=3000
# Panelin public URL-i (boşdursa platformadan avtomatik tapılır)
NEXT_PUBLIC_APP_URL=

# ─── Panel login ───
# Defolt: gasham / gasham1006. İlk girişdən sonra Settings → Təhlükəsizlik
# bölməsindən və ya bu dəyişənlərlə dəyişdirilə bilər.
ADMIN_USERNAME=gasham
ADMIN_PASSWORD=gasham1006

# ─── Persistent WhatsApp worker (Railway/VPS/Docker) ───
# Worker-in public API URL-i — məs. https://wpm-worker.up.railway.app
WORKER_API_URL=
# GİZLİ açar — web və worker-də EYNİ olmalıdır
WORKER_API_TOKEN=
# Worker-in WebSocket URL-i (boşdursa WORKER_API_URL-dən wss:// törəyir)
WORKER_WS_URL=
WORKER_TIMEOUT_MS=10000


# ─── Firebase Realtime Database (YEGANƏ verilənlər bazası) ───
# Bütün məlumatlar (istifadəçi, sessiyalar, kontaktlar, işlər, parametrlər,
# WhatsApp state) Firebase RTDB-də saxlanılır. Heç bir lokal fayl bazası,
# ./data qovluğu və ya PostgreSQL tələb olunmur — serverless də daxil.
# Dəyərlər boşdursa defolt layihə konfiqurasiyası (chatog-94528) istifadə olunur.
# FIREBASE_ENABLED=false — yalnız realtime event mirror söndürülür.
FIREBASE_ENABLED=true
FIREBASE_API_KEY=AIzaSyDnbN3yJfuHejYqTv5HsisJMec0QjpaJzg
FIREBASE_AUTH_DOMAIN=chatog-94528.firebaseapp.com
FIREBASE_DATABASE_URL=https://chatog-94528-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=chatog-94528
FIREBASE_STORAGE_BUCKET=chatog-94528.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=877401186095
FIREBASE_APP_ID=1:877401186095:web:04d181fbbf2aaebb64cbda

# ─── Broadcast pacing & limits ───
BROADCAST_DELAY_MIN_MS=3000
BROADCAST_DELAY_MAX_MS=7000
BROADCAST_MAX_RETRIES=2
DUPLICATE_SEND_TTL_MIN=10
WA_PRESENCE_CHECK=true
WA_SKIP_UNREGISTERED=true
MAX_RECIPIENTS=10000
MAX_MESSAGE_LENGTH=100000
MAX_UPLOAD_BYTES=62914560
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=10
