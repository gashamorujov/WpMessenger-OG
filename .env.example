# ─── WpMessenger OG — Environment Variables ───
# Copy to .env and adjust. Heç bir secret repo-ya yazılmır.
# Əksər dəyərlər boş qala bilər — platforma env-lərindən avtomatik təyin olunur.

# HTTP server port (Railway/Render/Heroku PORT-u avtomatik istifadə olunur)
PORT=3000

# ─── Panel login ───
# ADMIN_PASSWORD boş qalarsa təsadüfi şifrə yaradılır və loqlarda çap olunur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ─── URL-lər (boş qala bilər — avtomatik təyin olunur) ───
# FRONTEND_URL — panelin public URL-i (məs. https://panel.vercel.app)
# API_URL — persistent backend-in public URL-i (məs. https://wpm.up.railway.app)
#            Əgər backend panelin özüdürsə boş qoyun (eyni origin istifadə olunur)
# WS_URL  — WebSocket ünvanı; boşdursa API_URL-dən avtomatik törəyir (wss://)
# BACKEND_URL — API_URL-in alternativ adı
FRONTEND_URL=
API_URL=
WS_URL=
BACKEND_URL=

# ─── CORS ───
# Boşdursa: bütün origin-lərə API açıqdır (Bearer token auth ilə).
# Təyin olunarsa: yalnız sadalanan origin-lər (vergüllə ayrılır) + credentials.
CORS_ORIGIN=

# ─── Database / session persistence ───
# Local: ./data/app.db (və ya file:./data/app.db)
# Docker/Railway volume: /data/app.db (DATA_DIR=/data, SESSION_PATH=/data/sessions)
DATABASE_URL=./data/app.db
DATA_DIR=./data
SESSION_PATH=./sessions

# ─── Broadcast pacing (per-target random delay) ───
BROADCAST_DELAY_MIN_MS=3000
BROADCAST_DELAY_MAX_MS=7000
BROADCAST_MAX_RETRIES=2

# Cross-job duplicate-send guard TTL (dəqiqə; 0 = söndür)
DUPLICATE_SEND_TTL_MIN=10

# WhatsApp registration pre-check + skip unregistered
WA_PRESENCE_CHECK=true
WA_SKIP_UNREGISTERED=true

# ─── Təhlükəsizlik limitləri ───
MAX_RECIPIENTS=10000
MAX_MESSAGE_LENGTH=100000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# Proxy arxasında düzgün IP üçün (Railway/Render/Vercel üçün default: true)
TRUST_PROXY=true
